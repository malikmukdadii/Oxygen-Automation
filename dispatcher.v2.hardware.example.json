
{
  "schema_version": 2,
  "execution_backend": "oxygen_hardware",
  "simulation_only": false,
  "live_control": {
    "enable_physical_aout": true,
    "enable_rzxa_output_toggle": false,
    "enable_real_rzxa_scpi": false,
    "require_explicit_hardware_authorization": true
  },
  "hardware_authorization": {
    "wiring_verified": false,
    "supply_mapping_verified": false,
    "motor_neutral_verified": false,
    "external_emergency_stop_verified": false,
    "external_enable_control_verified": false
  },
  "connection": {"host": "127.0.0.1", "port": 10001, "timeout_s": 0.5},
  "outputs": {
    "rzxa_voltage_demand": {
      "role": "supply_voltage_demand",
      "channel": "Test Aout2",
      "display_name": "Physical RZ-XA voltage demand",
      "expected_id": null,
      "channel_discovery_required": true,
      "binding": "physical_supply",
      "authorization": {"simulation": false, "physical": true},
      "mode": "ConstOutput",
      "source": "DISCOVER_CONSTANT",
      "const_property": "auto",
      "min_aout_v": 0.0,
      "max_aout_v": 0.5,
      "startup_aout_v": 0.0,
      "mapping_verified": true,
      "mapping": {"type": "linear_verified", "gain_bus_v_per_aout_v": null, "verified": true},
      "output_enable": "EXTERNAL_VERIFIED",
      "completion_policy": "hold_until_explicit_change",
      "on_cancel": "preserve_demand",
      "on_fault": "preserve_demand",
      "on_shutdown": "preserve_demand"
    },
    "vesc_throttle": {
      "role": "motor_throttle",
      "channel": "Test Aout1",
      "display_name": "Physical VESC throttle",
      "expected_id": null,
      "channel_discovery_required": true,
      "binding": "physical_motor",
      "authorization": {"simulation": false, "physical": true},
      "mode": "ConstOutput",
      "source": "DISCOVER_CONSTANT",
      "const_property": "auto",
      "min_aout_v": 0.0,
      "max_aout_v": 0.4,
      "neutral_aout_v": 0.0,
      "neutral_verified": true,
      "mapping_verified": true,
      "completion_policy": "return_neutral",
      "on_cancel": "return_neutral",
      "on_fault": "return_neutral",
      "on_shutdown": "return_neutral"
    }
  },
  "timing": {"poll_ms": 100, "max_trigger_gap_ms": 1000, "interval_ms": 250, "max_lateness_ms": 1000},
  "measurement_roles": {
    "dc_bus_voltage": {"kind": "number", "unit": "V", "channel": null, "mapping_verified": false},
    "motor_input_mapping_verified": {"kind": "boolean", "channel": null, "property": null, "mapping_verified": false},
    "motor_physical_disable_verified": {"kind": "boolean", "channel": null, "property": null, "mapping_verified": false},
    "supply_external_ready": {"kind": "boolean", "channel": null, "property": null, "mapping_verified": false},
    "regen_safe": {"kind": "boolean", "channel": null, "property": null, "mapping_verified": false},
    "supply_shutdown_permitted": {"kind": "boolean", "channel": null, "property": null, "mapping_verified": false},
    "supply_standalone_test": {"kind": "boolean", "channel": null, "property": null, "mapping_verified": false},
    "supply_disabled": {"kind": "boolean", "channel": null, "property": null, "mapping_verified": false}
  },
  "interlocks": {
    "bus_target_v": 40.0,
    "bus_tolerance_v": 2.0,
    "max_feedback_age_s": 1.0,
    "motor_supply_demand_v": 0.5,
    "motor_requires_measured_bus_in_range": true,
    "supply_down_requires_motor_neutral": true,
    "one_active_profile_global": true,
    "allow_unverified_simulated_interlock_values": false,
    "allow_unverified_live_interlock_values": false,
    "external_emergency_stop_required_for_live": true
  },
  "recording": {"enabled": false, "markers": true},
  "instruments": {"rzxa": {"adapter": "disabled", "enable_output_control": false}},
  "assignments": [
    {"name": "rzxa_to_40_hold", "enabled": true, "trigger": "Ramp Enable", "output": "rzxa_voltage_demand", "profile": "profiles/hardware/rzxa_ramp_hold.json"},
    {"name": "rzxa_down", "enabled": true, "trigger": "Ramp Disable", "output": "rzxa_voltage_demand", "profile": "profiles/hardware/rzxa_ramp_down.json"},
    {"name": "motor_gentle", "enabled": true, "trigger": "Motor Gentle", "output": "vesc_throttle", "profile": "profiles/hardware/motor_gentle.json"}
  ]
}
