
{
  "schema_version": 2,
  "execution_backend": "oxygen_demo",
  "simulation_only": true,
  "live_control": {
    "enable_physical_aout": false,
    "enable_rzxa_output_toggle": false,
    "enable_real_rzxa_scpi": false,
    "require_explicit_hardware_authorization": true
  },
  "connection": {"host": "127.0.0.1", "port": 10001, "timeout_s": 0.5},
  "outputs": {
    "rzxa_voltage_demand": {
      "role": "supply_voltage_demand",
      "channel": "AO 3/1 Sim",
      "display_name": "RZ-XA voltage demand (mock)",
      "expected_id": null,
      "channel_discovery_required": true,
      "simulation_fixture": "oxygen_demo_supply",
      "authorization": {"simulation": true, "physical": false},
      "mode": "ConstOutput",
      "source": "DISCOVER_CONSTANT",
      "const_property": "auto",
      "min_aout_v": 0.0,
      "max_aout_v": 0.5,
      "startup_aout_v": 0.0,
      "completion_policy": "hold_until_explicit_change",
      "on_cancel": "preserve_demand",
      "on_fault": "preserve_demand",
      "on_shutdown": "preserve_demand",
      "mapping_verified": false,
      "mapping": {
        "type": "linear_provisional",
        "full_scale_aout_v": 10.0,
        "assumed_full_scale_bus_v": 800.0,
        "gain_bus_v_per_aout_v": 80.0,
        "verified": false
      },
      "output_enable": "NOT_CONTROLLED_BY_AOUT"
    },
    "vesc_throttle": {
      "role": "motor_throttle",
      "channel": "AO 3/2 Sim",
      "display_name": "VESC throttle (mock)",
      "expected_id": null,
      "channel_discovery_required": true,
      "simulation_fixture": "oxygen_demo_motor",
      "authorization": {"simulation": true, "physical": false},
      "mode": "ConstOutput",
      "source": "DISCOVER_CONSTANT",
      "const_property": "auto",
      "min_aout_v": 0.0,
      "max_aout_v": 0.4,
      "neutral_aout_v": 0.0,
      "neutral_verified": false,
      "mapping_verified": false,
      "completion_policy": "return_neutral",
      "on_cancel": "return_neutral",
      "on_fault": "return_neutral",
      "on_shutdown": "return_neutral"
    }
  },
  "timing": {"poll_ms": 50, "max_trigger_gap_ms": 500, "interval_ms": 150, "max_lateness_ms": 500},
  "measurement_roles": {
    "dc_bus_voltage": {"kind": "number", "unit": "V", "channel": null, "mapping_verified": false},
    "motor_input_mapping_verified": {"kind": "boolean", "channel": null, "mapping_verified": false},
    "motor_physical_disable_verified": {"kind": "boolean", "channel": null, "mapping_verified": false},
    "supply_external_ready": {"kind": "boolean", "channel": null, "mapping_verified": false},
    "regen_safe": {"kind": "boolean", "channel": null, "mapping_verified": false},
    "supply_shutdown_permitted": {"kind": "boolean", "channel": null, "mapping_verified": false},
    "supply_standalone_test": {"kind": "boolean", "channel": null, "mapping_verified": false},
    "supply_disabled": {"kind": "boolean", "channel": null, "mapping_verified": false}
  },
  "interlocks": {
    "bus_target_v": 40.0,
    "bus_tolerance_v": 2.0,
    "max_feedback_age_s": 1.0,
    "motor_supply_demand_v": 0.5,
    "motor_requires_measured_bus_in_range": true,
    "supply_down_requires_motor_neutral": true,
    "one_active_profile_global": true,
    "allow_unverified_simulated_interlock_values": true,
    "allow_unverified_live_interlock_values": false,
    "external_emergency_stop_required_for_live": true
  },
  "recording": {"enabled": false, "markers": true},
  "instruments": {"rzxa": {"adapter": "disabled", "enable_output_control": false}},
  "assignments": [
    {"name": "rzxa_to_40_hold", "enabled": true, "trigger": "DO 3/1 Sim", "output": "rzxa_voltage_demand", "profile": "../../profiles/rzxa_demand_ramp_40v_hold.json"},
    {"name": "rzxa_down", "enabled": true, "trigger": "DO 3/2 Sim", "output": "rzxa_voltage_demand", "profile": "../../profiles/rzxa_demand_ramp_down.json"},
    {"name": "rzxa_36_40_36", "enabled": true, "trigger": "DO 3/3 Sim", "output": "rzxa_voltage_demand", "profile": "../../profiles/rzxa_demand_36_40_36.json"},
    {"name": "motor_gentle", "enabled": true, "trigger": "DO 3/4 Sim", "output": "vesc_throttle", "profile": "../../profiles/motor_gentle_ramp.json"},
    {"name": "motor_stop_go", "enabled": true, "trigger": "DO 3/5 Sim", "output": "vesc_throttle", "profile": "../../profiles/motor_stop_go.json"},
    {"name": "motor_cruise", "enabled": true, "trigger": "DO 3/6 Sim", "output": "vesc_throttle", "profile": "../../profiles/motor_cruise_steps.json"}
  ],
  "simulation": {
    "namespace": "OXYGEN_SIMULATED_IO_FAKE_TELEMETRY",
    "outputs": {},
    "sample_interval_s": 0.1,
    "streaming": true,
    "telemetry": {
      "dc_bus_voltage": 40.0,
      "motor_input_mapping_verified": true,
      "motor_physical_disable_verified": true,
      "supply_external_ready": true,
      "regen_safe": true,
      "supply_shutdown_permitted": true,
      "supply_standalone_test": true,
      "supply_disabled": false
    }
  }
}
