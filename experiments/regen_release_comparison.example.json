{
  "schema_version": 1,
  "experiment_type": "regenerative_deceleration",
  "name": "regen_release_comparison",
  "description": "Illustrative offline comparison of Drive Control release duration at constant bus and start ERPM. Not commissioned for physical use. Braking Control unused. Higher drive candidates are planning-only and disabled.",
  "simulation_only": true,
  "physical_enabled": false,
  "illustrative_only": true,
  "dispatcher_bindings": "examples/memory-regen.json",
  "commissioned_drive_limit_v": 0.40,
  "higher_drive_limit_authorized": false,
  "drive_limit_candidates": [
    {"value_v": 0.40, "enabled": true, "commissioned": true},
    {"value_v": 0.55, "enabled": false, "commissioned": false},
    {"value_v": 0.70, "enabled": false, "commissioned": false},
    {"value_v": 0.85, "enabled": false, "commissioned": false}
  ],
  "comparison": "release_duration",
  "bus_setpoints_v": [40.0],
  "speed_targets_erpm": [
    {"target_erpm": 8000, "enabled": true, "commissioned": true, "max_speed_authorized": false}
  ],
  "release_durations_s": [0.10, 0.50, 1.00],
  "drive_demand_v": 0.40,
  "accel": {"ramp_s": 0.20, "hold_s": 0.20},
  "settle_s": 0.10,
  "recovery_observe_s": 0.50,
  "inter_trial_recovery_s": 0.20,
  "repetitions": 2,
  "start_condition": {
    "erpm_tolerance": 1500,
    "bus_tolerance_v": 2.0,
    "require_measured_erpm": false
  },
  "energy": {
    "use_synthetic_when_no_csv": true,
    "channel_map": {
      "time_s": "time_s",
      "dc_voltage_v": "dc_voltage_v",
      "dc_current_a": "dc_current_a",
      "dc_power_w": "dc_power_w",
      "erpm": "erpm",
      "drive_control_v": "drive_control_v"
    }
  },
  "rzxa_completion_policy": "preserve_demand",
  "output_dir": "logs/regen-experiments"
}
