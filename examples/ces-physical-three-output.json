{
  "schema_version": 3,
  "control": {"mode": "open_loop"},
  "transport": "oxygen_scpi",
  "live_control": {
    "enable_physical_aout": true,
    "enable_physical_brake": true,
    "enable_rzxa_output_toggle": false,
    "enable_real_rzxa_scpi": false,
    "require_explicit_hardware_authorization": true
  },
  "hardware_authorization": {
    "wiring_verified": true,
    "supply_mapping_verified": true,
    "motor_neutral_verified": true,
    "brake_release_verified": true,
    "external_emergency_stop_verified": true,
    "external_enable_control_verified": true
  },
  "open_loop_authorization": {
    "no_live_feedback_acknowledged": true,
    "external_bus_and_regen_protection_verified": true
  },
  "connection": {"host": "127.0.0.1", "port": 10001, "timeout_s": 0.5},
  "outputs": {
    "rzxa_voltage_demand": {
      "role": "supply_voltage_demand",
      "channel": "Takasago Voltage Control",
      "display_name": "AO2/3 RZ-XA demand; output enable remains external",
      "expected_id": null,
      "channel_discovery_required": true,
      "binding": "physical_supply",
      "authorization": {"simulation": false, "physical": true},
      "mode": "ConstOutput",
      "source": "DISCOVER_CONSTANT",
      "const_property": "auto",
      "min_aout_v": 0.0,
      "max_aout_v": 0.5,
      "startup_aout_v": 0.0,
      "mapping_verified": true,
      "mapping": {"type": "linear_verified", "gain_bus_v_per_aout_v": 80.0, "verified": true},
      "output_enable": "EXTERNAL_VERIFIED",
      "completion_policy": "hold_final",
      "on_cancel": "preserve_demand",
      "on_fault": "preserve_demand",
      "on_shutdown": "preserve_demand"
    },
    "vesc_throttle": {
      "role": "motor_throttle",
      "channel": "Drive Control",
      "display_name": "AO2/1 VESC ADC1; Current No Reverse Brake ADC2",
      "expected_id": null,
      "channel_discovery_required": true,
      "binding": "physical_drive",
      "authorization": {"simulation": false, "physical": true},
      "mode": "ConstOutput",
      "source": "DISCOVER_CONSTANT",
      "const_property": "auto",
      "min_aout_v": 0.0,
      "max_aout_v": 1.6,
      "commissioned_drive_limit_v": 1.6,
      "higher_drive_limit_authorized": true,
      "neutral_aout_v": 0.0,
      "neutral_verified": true,
      "mapping_verified": true,
      "completion_policy": "return_neutral",
      "on_cancel": "return_neutral",
      "on_fault": "return_neutral",
      "on_shutdown": "return_neutral"
    },
    "vesc_brake": {
      "role": "motor_brake",
      "channel": "Braking Control",
      "display_name": "AO2/2 VESC ADC2; 0..3.3 V input span, not a brake-intensity setting",
      "expected_id": null,
      "channel_discovery_required": true,
      "binding": "physical_brake",
      "authorization": {"simulation": false, "physical": true},
      "mode": "ConstOutput",
      "source": "DISCOVER_CONSTANT",
      "const_property": "auto",
      "min_aout_v": 0.0,
      "max_aout_v": 3.3,
      "brake_min_aout_v": 0.0,
      "brake_max_aout_v": 3.3,
      "brake_release_aout_v": 0.0,
      "brake_release_verified": true,
      "completion_policy": "return_release",
      "on_cancel": "return_release",
      "on_fault": "return_release",
      "on_shutdown": "return_release"
    }
  },
  "timing": {"poll_ms": 50, "max_trigger_gap_ms": 250, "interval_ms": 100, "max_lateness_ms": 250, "telemetry_poll_ms": 0},
  "measurements": {},
  "interlocks": {
    "motor_supply_demands_v": [0.45, 0.45625, 0.4625, 0.46875, 0.475, 0.48125, 0.4875, 0.49375, 0.5],
    "supply_demand_grid_commissioned": true,
    "require_supply_demand_before_motor": true,
    "supply_down_requires_motor_neutral": true,
    "drive_brake_mutual_exclusion": true,
    "zero_drive_before_brake": true,
    "release_brake_before_drive": true,
    "one_active_profile_global": true,
    "external_emergency_stop_required_for_live": true
  },
  "recording": {"enabled": false, "markers": true},
  "instruments": {"rzxa": {"adapter": "disabled", "enable_output_control": false}},
  "assignments": [
    {"name": "rzxa_to_40_hold", "trigger": "Ramp Enable", "output": "rzxa_voltage_demand", "profile": "../profiles/rzxa_ramp_hold.json"},
    {"name": "rzxa_down", "trigger": "Ramp Disable", "output": "rzxa_voltage_demand", "profile": "../profiles/rzxa_ramp_down.json"},
    {"name": "motor_gentle", "trigger": "Motor Gentle", "output": "vesc_throttle", "profile": "../profiles/ces/motor_gentle.json"},
    {"name": "regen_test", "trigger": "Run Regen Test", "output": "vesc_throttle", "profile": "../profiles/ces/motor_regen_trial_b.json", "parameters": {"brake_target_v": 0.20}},
    {"name": "driving_cycle", "trigger": "Run Driving Cycle", "output": "vesc_throttle", "profile": "../profiles/ces/motor_stop_go.json", "parameters": {"brake_light_v": 0.15, "brake_heavy_v": 0.20}},
    {"name": "efficiency_scan", "trigger": "Run Efficiency Scan", "output": "vesc_throttle", "profile": "../profiles/ces/motor_three_level.json"},
    {"name": "rzxa_voltage_down", "trigger": "RZ-XA Step Down", "output": "rzxa_voltage_demand", "profile": "../profiles/rzxa_voltage_down.json"},
    {"name": "rzxa_voltage_up", "trigger": "RZ-XA Step Up", "output": "rzxa_voltage_demand", "profile": "../profiles/rzxa_voltage_up.json"}
  ]
}
