{
  "schema_version": 3,
  "control": {"mode": "open_loop"},
  "transport": "memory",
  "live_control": {
    "enable_physical_aout": false,
    "enable_physical_brake": false,
    "enable_rzxa_output_toggle": false,
    "enable_real_rzxa_scpi": false,
    "require_explicit_hardware_authorization": true
  },
  "connection": {"host": "127.0.0.1", "port": 10001, "timeout_s": 0.5},
  "outputs": {
    "rzxa_voltage_demand": {
      "role": "supply_voltage_demand",
      "channel": null,
      "display_name": "Takasago Voltage Control (memory fixture only)",
      "expected_id": null,
      "channel_discovery_required": true,
      "binding": "supply_demand_fixture",
      "authorization": {"simulation": true, "physical": false},
      "mode": "ConstOutput",
      "source": "CONST0",
      "const_property": "TRION/SourceChannel_A_CONST/Const0",
      "min_aout_v": 0.0,
      "max_aout_v": 0.5,
      "startup_aout_v": 0.0,
      "completion_policy": "hold_final",
      "on_cancel": "preserve_demand",
      "on_fault": "preserve_demand",
      "on_shutdown": "preserve_demand",
      "mapping_verified": false,
      "mapping": {
        "type": "linear_provisional",
        "full_scale_aout_v": 10.0,
        "assumed_full_scale_bus_v": 800.0,
        "gain_bus_v_per_aout_v": 80.0,
        "verified": false
      },
      "output_enable": "NOT_CONTROLLED_BY_AOUT"
    },
    "vesc_throttle": {
      "role": "motor_throttle",
      "channel": null,
      "display_name": "Drive Control (memory fixture; ADC1 upper command authorized to 1.60 V after manual test)",
      "expected_id": null,
      "channel_discovery_required": true,
      "binding": "motor_throttle_fixture",
      "authorization": {"simulation": true, "physical": false},
      "mode": "ConstOutput",
      "source": "CONST0",
      "const_property": "TRION/SourceChannel_A_CONST/Const0",
      "min_aout_v": 0.0,
      "max_aout_v": 1.6,
      "commissioned_drive_limit_v": 1.6,
      "higher_drive_limit_authorized": true,
      "neutral_aout_v": 0.0,
      "neutral_verified": false,
      "mapping_verified": false,
      "completion_policy": "return_neutral",
      "on_cancel": "return_neutral",
      "on_fault": "return_neutral",
      "on_shutdown": "return_neutral"
    },
    "vesc_brake": {
      "role": "motor_brake",
      "channel": null,
      "display_name": "Braking Control (memory fixture; release 0 V; provisional sim brake demand only)",
      "expected_id": null,
      "channel_discovery_required": true,
      "binding": "motor_brake_fixture",
      "authorization": {"simulation": true, "physical": false},
      "mode": "ConstOutput",
      "source": "CONST0",
      "const_property": "TRION/SourceChannel_A_CONST/Const0",
      "min_aout_v": 0.0,
      "max_aout_v": 3.3,
      "brake_min_aout_v": 0.0,
      "brake_max_aout_v": 3.3,
      "brake_release_aout_v": 0.0,
      "brake_release_verified": false,
      "completion_policy": "return_release",
      "on_cancel": "return_release",
      "on_fault": "return_release",
      "on_shutdown": "return_release"
    }
  },
  "timing": {
    "poll_ms": 20,
    "max_trigger_gap_ms": 100,
    "interval_ms": 20,
    "max_lateness_ms": 250,
    "telemetry_poll_ms": 0
  },
  "measurements": {
    "dc_bus_voltage": {
      "kind": "number",
      "unit": "V",
      "channel": "Sim DC Bus Voltage",
      "property": null,
      "mapping_verified": false
    },
    "erpm": {
      "kind": "number",
      "unit": "erpm",
      "channel": "Sim ERPM",
      "property": null,
      "mapping_verified": false
    }
  },
  "interlocks": {
    "motor_supply_demands_v": [
      0.45, 0.453125, 0.45625, 0.459375, 0.4625, 0.465625, 0.46875, 0.471875,
      0.475, 0.478125, 0.48125, 0.484375, 0.4875, 0.490625, 0.49375, 0.496875, 0.5
    ],
    "supply_demand_step_v": 0.25,
    "supply_demand_grid_commissioned": false,
    "require_supply_demand_before_motor": true,
    "supply_down_requires_motor_neutral": true,
    "drive_brake_mutual_exclusion": true,
    "zero_drive_before_brake": true,
    "release_brake_before_drive": true,
    "one_active_profile_global": true,
    "external_emergency_stop_required_for_live": true
  },
  "recording": {"enabled": false, "markers": true},
  "instruments": {"rzxa": {"adapter": "disabled", "enable_output_control": false}},
  "motor_sweep_defaults": {
    "start_v": 36.0,
    "end_v": 40.0,
    "step_v": 0.25,
    "initial_direction": "descending",
    "settle_s": 0.5,
    "fast_regen": {
      "throttle_target_v": 1.6,
      "brake_target_v": 0.20,
      "accel_ramp_s": 0.25,
      "accel_hold_s": 1.5,
      "throttle_release_s": 0.15,
      "transition_s": 0.10,
      "brake_ramp_s": 0.20,
      "brake_hold_s": 1.5,
      "brake_release_s": 0.15,
      "recovery_s": 0.50
    }
  },
  "assignments": [
    {"name": "rzxa_to_40_hold", "trigger": "Ramp Enable", "output": "rzxa_voltage_demand", "profile": "../profiles/rzxa_ramp_hold.json"},
    {"name": "rzxa_down", "trigger": "Ramp Disable", "output": "rzxa_voltage_demand", "profile": "../profiles/rzxa_ramp_down.json"},
    {"name": "motor_gentle", "trigger": "Motor Gentle", "output": "vesc_throttle", "profile": "../profiles/ces/motor_gentle.json"},
    {"name": "regen_test", "trigger": "Run Regen Test", "output": "vesc_throttle", "profile": "../profiles/ces/motor_regen_trial_b.json", "parameters": {"brake_target_v": 0.20}},
    {"name": "driving_cycle", "trigger": "Run Driving Cycle", "output": "vesc_throttle", "profile": "../profiles/ces/motor_stop_go.json", "parameters": {"brake_light_v": 0.15, "brake_heavy_v": 0.20}},
    {"name": "efficiency_scan", "trigger": "Run Efficiency Scan", "output": "vesc_throttle", "profile": "../profiles/ces/motor_three_level.json"},
    {"name": "rzxa_voltage_down", "trigger": "RZ-XA Step Down", "output": "rzxa_voltage_demand", "profile": "../profiles/rzxa_voltage_down.json"},
    {"name": "rzxa_voltage_up", "trigger": "RZ-XA Step Up", "output": "rzxa_voltage_demand", "profile": "../profiles/rzxa_voltage_up.json"},
    {
      "name": "fast_regen_test",
      "kind": "fast_regen",
      "trigger": "Fast Regen Test",
      "output": "vesc_throttle",
      "parameters": {"brake_target_v": 0.20}
    },
    {
      "name": "motor_sweep_open_loop",
      "kind": "motor_sweep",
      "trigger": "Open Loop Sweep",
      "output": "vesc_throttle",
      "motor_sweep": {
        "mode": "open_loop",
        "round_trips": 1,
        "continuous": false
      }
    },
    {
      "name": "motor_sweep_voltage_closed_loop",
      "enabled": false,
      "kind": "motor_sweep",
      "trigger": "Voltage Closed Loop Sweep",
      "output": "vesc_throttle",
      "motor_sweep": {
        "mode": "voltage_closed_loop",
        "round_trips": 1,
        "continuous": false,
        "voltage_qualify": {
          "channel": "dc_bus_voltage",
          "tolerance_v": 0.10,
          "qualify_duration_s": 0.20,
          "timeout_s": 3.0,
          "poll_s": 0.020,
          "max_age_s": 0.250
        }
      }
    },
    {
      "name": "motor_sweep_full_closed_loop",
      "enabled": false,
      "kind": "motor_sweep",
      "trigger": "Full Closed Loop Sweep",
      "output": "vesc_throttle",
      "motor_sweep": {
        "mode": "full_closed_loop",
        "round_trips": 1,
        "continuous": false,
        "voltage_qualify": {
          "channel": "dc_bus_voltage",
          "tolerance_v": 0.10,
          "qualify_duration_s": 0.20,
          "timeout_s": 3.0,
          "poll_s": 0.020,
          "max_age_s": 0.250
        },
        "rpm_feedback": {
          "channel": "erpm",
          "kind": "electrical",
          "poll_s": 0.020,
          "max_age_s": 0.250,
          "accel_timeout_s": 5.0,
          "brake_timeout_s": 5.0
        },
        "fast_regen": {
          "throttle_target_v": 1.6,
          "brake_target_v": 0.20,
          "accel_rpm_target": 1000,
          "brake_rpm_target": 100,
          "rpm_kind": "electrical"
        }
      }
    },
    {
      "name": "stop_sweep",
      "kind": "stop_sweep",
      "trigger": "Stop Sweep",
      "output": "vesc_throttle"
    }
  ],
  "simulation": {
    "namespace": "FAKE_IN_PROCESS_ONLY",
    "outputs": {
      "supply_demand_fixture": {
        "name": "Takasago Voltage Control", "id": "101",
        "mode": "ConstOutput", "source": "CONST0", "property": "TRION/SourceChannel_A_CONST/Const0",
        "unit": "V", "min_v": 0.0, "max_v": 0.5, "initial_v": 0.0
      },
      "motor_throttle_fixture": {
        "name": "Drive Control", "id": "102",
        "mode": "ConstOutput", "source": "CONST0", "property": "TRION/SourceChannel_A_CONST/Const0",
        "unit": "V", "min_v": 0.0, "max_v": 1.6, "initial_v": 0.0
      },
      "motor_brake_fixture": {
        "name": "Braking Control", "id": "103",
        "mode": "ConstOutput", "source": "CONST0", "property": "TRION/SourceChannel_A_CONST/Const0",
        "unit": "V", "min_v": 0.0, "max_v": 3.3, "initial_v": 0.0
      }
    },
    "sample_interval_s": 0.02,
    "streaming": true,
    "telemetry": {
      "dc_bus_voltage": 40.0,
      "erpm": 0.0
    }
  }
}
