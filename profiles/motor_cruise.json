{
  "schema_version": 3,
  "name": "motor_cruise",
  "description": "Open-loop demand plateaus at 0.20/0.40/0.25 V, five seconds each, for CAN speed and electrical-power comparison. These are demand levels, not regulated speeds. Supply demand unchanged; finishes at neutral.",
  "output": "vesc_throttle",
  "timeout_s": 45,
  "completion": {"mode": "return_neutral", "value": 0.0},
  "requires": {"motor_neutral": true, "motor_enable": "operator_verified"},
  "steps": [
    {"type": "assert_preconditions", "params": {"motor_neutral": true}},
    {"type": "set_aout", "params": {"channel": "vesc_throttle", "value": 0.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.2, "duration_s": 2.0}},
    {"type": "checkpoint", "params": {"name": "motor_020_v_plateau"}},
    {"type": "hold", "params": {"duration_s": 5.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.4, "duration_s": 2.0}},
    {"type": "checkpoint", "params": {"name": "motor_040_v_plateau"}},
    {"type": "hold", "params": {"duration_s": 5.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.25, "duration_s": 2.0}},
    {"type": "checkpoint", "params": {"name": "motor_025_v_plateau"}},
    {"type": "hold", "params": {"duration_s": 5.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.0, "duration_s": 3.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_throttle"}},
    {"type": "checkpoint", "params": {"name": "motor_cruise_neutral"}}
  ]
}
