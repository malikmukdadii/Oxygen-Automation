
{
  "schema_version": 2,
  "name": "physical_supply_ramp_hold",
  "simulation_only": false,
  "output": "rzxa_voltage_demand",
  "timeout_s": 30,
  "completion": {"mode": "hold_final", "value": 0.5, "operator_action_required_to_stop": true},
  "requires": {"supply_output_enable": "external_or_explicitly_verified", "motor_neutral": true},
  "steps": [
    {"type": "assert_preconditions", "params": {"motor_neutral": true, "supply_output_enabled_or_verified_external": true, "supply_standalone_test": true, "current_aout_must_be_zero_or_already_target": true, "reject_other_start_values": true}},
    {"type": "ramp_aout", "params": {"channel": "rzxa_voltage_demand", "target": 0.5, "duration_s": 5.0}},
    {"type": "hold", "params": {"duration_s": 3.0}}
  ]
}
