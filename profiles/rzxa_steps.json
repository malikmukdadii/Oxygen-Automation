{
  "schema_version": 3,
  "name": "rzxa_steps",
  "description": "Repeatable 0.45/0.50 V supply-demand plateaus with checkpoint labels for DC voltage/current/power comparison. At verified 80 V/V these correspond to nominal 36/40 V, not measured bus voltage. Supply-only compatible; dual-output neutral sequencing remains config-driven.",
  "output": "rzxa_voltage_demand",
  "timeout_s": 50,
  "completion": {"mode": "hold_final", "value": 0.5, "operator_action_required_to_stop": true},
  "requires": {},
  "steps": [
    {"type": "checkpoint", "params": {"name": "supply_characterization_start"}},
    {"type": "ramp_aout", "params": {"channel": "rzxa_voltage_demand", "target": 0.45, "duration_s": 3.0}},
    {"type": "checkpoint", "params": {"name": "supply_045_v_first_plateau"}},
    {"type": "hold", "params": {"duration_s": 5.0}},
    {"type": "ramp_aout", "params": {"channel": "rzxa_voltage_demand", "target": 0.5, "duration_s": 2.0}},
    {"type": "checkpoint", "params": {"name": "supply_050_v_first_plateau"}},
    {"type": "hold", "params": {"duration_s": 5.0}},
    {"type": "ramp_aout", "params": {"channel": "rzxa_voltage_demand", "target": 0.45, "duration_s": 2.0}},
    {"type": "checkpoint", "params": {"name": "supply_045_v_repeat_plateau"}},
    {"type": "hold", "params": {"duration_s": 5.0}},
    {"type": "ramp_aout", "params": {"channel": "rzxa_voltage_demand", "target": 0.5, "duration_s": 2.0}},
    {"type": "checkpoint", "params": {"name": "supply_050_v_repeat_plateau"}},
    {"type": "hold", "params": {"duration_s": 5.0}},
    {"type": "checkpoint", "params": {"name": "supply_characterization_complete_hold"}}
  ]
}
