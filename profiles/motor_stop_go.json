{
  "schema_version": 3,
  "name": "motor_stop_go",
  "description": "Run Driving Cycle coordinated offline waveform: accel bursts, coast, and provisional ADC2 brake intervals with brake released before each accel. Live braking remains disabled.",
  "output": "vesc_throttle",
  "outputs": ["vesc_throttle", "vesc_brake"],
  "timeout_s": 55,
  "completion": {"mode": "return_neutral", "value": 0.0},
  "requires": {"motor_neutral": true, "motor_enable": "operator_verified", "brake_released": true},
  "steps": [
    {"type": "assert_preconditions", "params": {"motor_neutral": true, "brake_released": true}},
    {"type": "set_aout", "params": {"channel": "vesc_throttle", "value": 0.0}},
    {"type": "set_aout", "params": {"channel": "vesc_brake", "value": 0.0}},
    {"type": "checkpoint", "params": {"name": "burst_1_accel"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.2, "duration_s": 2.0}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.0, "duration_s": 2.0}},
    {"type": "checkpoint", "params": {"name": "burst_1_coast"}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "checkpoint", "params": {"name": "burst_1_brake"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_brake", "target": 0.15, "duration_s": 1.5}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_brake", "target": 0.0, "duration_s": 1.5}},
    {"type": "return_neutral", "params": {"channel": "vesc_brake"}},
    {"type": "checkpoint", "params": {"name": "burst_2_accel"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.35, "duration_s": 2.0}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.0, "duration_s": 2.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_throttle"}},
    {"type": "checkpoint", "params": {"name": "driving_cycle_complete"}}
  ]
}
