{
  "schema_version": 3,
  "name": "motor_stop_go",
  "description": "LEGACY ZERO-DEMAND MAPPING ONLY: historical 0.20/0.35 V pulses ending at 0 V. On the CES VESC these levels are not a commissioned acceleration/coast sequence and 0 V produced braking. Do not deploy on that rig. Revised, uncommissioned memory-only replacement: profiles/ces/motor_stop_go.json.",
  "output": "vesc_throttle",
  "timeout_s": 30,
  "completion": {"mode": "return_neutral", "value": 0.0},
  "requires": {"motor_neutral": true, "motor_enable": "operator_verified"},
  "steps": [
    {"type": "assert_preconditions", "params": {"motor_neutral": true}},
    {"type": "set_aout", "params": {"channel": "vesc_throttle", "value": 0.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.2, "duration_s": 2.0}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.0, "duration_s": 2.0}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.35, "duration_s": 2.0}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.0, "duration_s": 2.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_throttle"}}
  ]
}
