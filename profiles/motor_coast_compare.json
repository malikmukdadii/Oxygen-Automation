{
  "schema_version": 3,
  "name": "motor_coast_compare",
  "description": "Run Regen Test coordinated offline waveform: ADC1 accel → hold → release to coast → ADC2 provisional brake → release, with coast comparison hold. Brake voltages are provisional memory-only rehearsal values; live braking remains disabled.",
  "output": "vesc_throttle",
  "outputs": ["vesc_throttle", "vesc_brake"],
  "timeout_s": 80,
  "completion": {"mode": "return_neutral", "value": 0.0},
  "requires": {"motor_neutral": true, "motor_enable": "operator_verified", "brake_released": true},
  "steps": [
    {"type": "assert_preconditions", "params": {"motor_neutral": true, "brake_released": true}},
    {"type": "set_aout", "params": {"channel": "vesc_throttle", "value": 0.0}},
    {"type": "set_aout", "params": {"channel": "vesc_brake", "value": 0.0}},
    {"type": "checkpoint", "params": {"name": "drive_trial_start"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.25, "duration_s": 4.0}},
    {"type": "checkpoint", "params": {"name": "drive_025_v_plateau"}},
    {"type": "hold", "params": {"duration_s": 5.0}},
    {"type": "checkpoint", "params": {"name": "drive_release_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.0, "duration_s": 1.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_throttle"}},
    {"type": "checkpoint", "params": {"name": "coast_observation_begin"}},
    {"type": "hold", "params": {"duration_s": 5.0}},
    {"type": "checkpoint", "params": {"name": "brake_trial_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_brake", "target": 0.2, "duration_s": 2.0}},
    {"type": "hold", "params": {"duration_s": 4.0}},
    {"type": "checkpoint", "params": {"name": "brake_hold"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_brake", "target": 0.0, "duration_s": 2.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_brake"}},
    {"type": "checkpoint", "params": {"name": "brake_release_complete"}},
    {"type": "hold", "params": {"duration_s": 5.0}},
    {"type": "checkpoint", "params": {"name": "coast_comparison_complete"}}
  ]
}
