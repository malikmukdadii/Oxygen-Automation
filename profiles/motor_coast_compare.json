{
  "schema_version": 3,
  "name": "motor_coast_compare",
  "description": "LEGACY ZERO-DEMAND MAPPING ONLY: historical 0.25 V AOUT-demand trials ending at 0 V normal stop demand. The filename does not establish coast: 0.3 V still requests positive current and 0 V requests normal deceleration. Neither deceleration nor the filename proves regeneration or fault safety. Voltage-to-current mapping is not calibrated. Waveform retained for compatibility, not newly commissioned. Revised staged candidate: profiles/ces/motor_coast_compare.json.",
  "output": "vesc_throttle",
  "timeout_s": 65,
  "completion": {"mode": "return_neutral", "value": 0.0},
  "requires": {"motor_neutral": true, "motor_enable": "operator_verified"},
  "steps": [
    {"type": "assert_preconditions", "params": {"motor_neutral": true}},
    {"type": "checkpoint", "params": {"name": "fast_release_trial_start"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.25, "duration_s": 4.0}},
    {"type": "checkpoint", "params": {"name": "fast_release_025_v_plateau"}},
    {"type": "hold", "params": {"duration_s": 5.0}},
    {"type": "checkpoint", "params": {"name": "fast_release_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.0, "duration_s": 1.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_throttle"}},
    {"type": "checkpoint", "params": {"name": "fast_release_neutral_observation"}},
    {"type": "hold", "params": {"duration_s": 10.0}},
    {"type": "checkpoint", "params": {"name": "slow_release_trial_start"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.25, "duration_s": 4.0}},
    {"type": "checkpoint", "params": {"name": "slow_release_025_v_plateau"}},
    {"type": "hold", "params": {"duration_s": 5.0}},
    {"type": "checkpoint", "params": {"name": "slow_release_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.0, "duration_s": 5.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_throttle"}},
    {"type": "checkpoint", "params": {"name": "slow_release_neutral_observation"}},
    {"type": "hold", "params": {"duration_s": 10.0}},
    {"type": "checkpoint", "params": {"name": "coast_comparison_complete"}}
  ]
}
