{
  "schema_version": 3,
  "name": "rzxa_ramp_down",
  "description": "Open-loop supply-demand ramp to 0 V after motor neutral. Persists only until this profile finishes at zero.",
  "output": "rzxa_voltage_demand",
  "timeout_s": 30,
  "completion": {"mode": "verify_zero", "value": 0.0},
  "requires": {"motor_neutral": true},
  "steps": [
    {"type": "assert_preconditions", "params": {"motor_neutral": true}},
    {"type": "ramp_aout", "params": {"channel": "rzxa_voltage_demand", "target": 0.0, "duration_s": 5.0}},
    {"type": "checkpoint", "params": {"name": "supply_commanded_zero"}}
  ]
}
