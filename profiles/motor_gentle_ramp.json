{
  "schema_version": 2,
  "name": "motor_gentle_ramp",
  "description": "Motor-only simulated throttle ramp; supply demand remains untouched. 0-0.25 V are placeholder AOUT values, not commissioned VESC controls.",
  "simulation_only": true,
  "output": "vesc_throttle",
  "timeout_s": 15,
  "completion": {
    "mode": "return_neutral",
    "value": 0.0
  },
  "steps": [
    {
      "type": "assert_preconditions",
      "params": {
        "bus_voltage_validated": true
      }
    },
    {
      "type": "set_aout",
      "params": {
        "channel": "vesc_throttle",
        "value": 0.0
      }
    },
    {
      "type": "ramp_aout",
      "params": {
        "channel": "vesc_throttle",
        "target": 0.25,
        "duration_s": 3
      }
    },
    {
      "type": "hold",
      "params": {
        "duration_s": 3
      }
    },
    {
      "type": "ramp_aout",
      "params": {
        "channel": "vesc_throttle",
        "target": 0.0,
        "duration_s": 3
      }
    },
    {
      "type": "return_neutral",
      "params": {
        "channel": "vesc_throttle"
      }
    }
  ],
  "requires": {
    "measured_bus_voltage": {
      "target_v": 40.0,
      "tolerance_v": 2.0,
      "max_age_s": 1.0
    },
    "motor_enable": "operator_verified"
  }
}
