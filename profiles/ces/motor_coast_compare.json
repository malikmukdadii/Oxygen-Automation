{
  "schema_version": 3,
  "name": "ces_motor_regen_candidate",
  "description": "MEMORY-ONLY commissioning candidate: 0.80 V drive, modeled 0.30 V coast, distinct 0.10 V braking request, return to modeled coast. Braking does not prove regeneration; verify signed DC power and sink acceptance independently before live use.",
  "output": "vesc_throttle",
  "timeout_s": 40,
  "completion": {"mode": "return_neutral", "value": 0.3},
  "requires": {"motor_neutral": true, "motor_enable": "operator_verified"},
  "steps": [
    {"type": "assert_preconditions", "params": {"motor_neutral": true}},
    {"type": "set_aout", "params": {"channel": "vesc_throttle", "value": 0.3}},
    {"type": "checkpoint", "params": {"name": "candidate_regen_acceleration_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.8, "duration_s": 4.0}},
    {"type": "checkpoint", "params": {"name": "candidate_regen_drive_080_begin"}},
    {"type": "hold", "params": {"duration_s": 4.0}},
    {"type": "checkpoint", "params": {"name": "candidate_regen_release_to_coast_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.3, "duration_s": 2.0}},
    {"type": "checkpoint", "params": {"name": "candidate_regen_coast_begin"}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "checkpoint", "params": {"name": "candidate_regen_brake_request_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.1, "duration_s": 1.0}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "checkpoint", "params": {"name": "candidate_regen_brake_release_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.3, "duration_s": 1.0}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_throttle"}},
    {"type": "checkpoint", "params": {"name": "candidate_regen_complete"}}
  ]
}
