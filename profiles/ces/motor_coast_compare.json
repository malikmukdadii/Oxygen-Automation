{
  "schema_version": 3,
  "name": "ces_motor_regen_coast_trial_a",
  "description": "Run Regen Test Trial A (coast, unmatched open-loop timing): ADC1 accel to operator-tested 1.60 V peak, return to 0 V, keep ADC2 at 0 V release, observe passive decel. Does not claim matched start RPM without sync measurement; RPM-triggered brake remains disabled. Live ADC2 braking is a separate commissioning workstream.",
  "output": "vesc_throttle",
  "outputs": ["vesc_throttle"],
  "timeout_s": 40,
  "completion": {"mode": "return_neutral", "value": 0.0},
  "requires": {"motor_neutral": true, "motor_enable": "operator_verified"},
  "steps": [
    {"type": "assert_preconditions", "params": {"motor_neutral": true}},
    {"type": "set_aout", "params": {"channel": "vesc_throttle", "value": 0.0}},
    {"type": "checkpoint", "params": {"name": "trial_a_coast_accel_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 1.6, "duration_s": 3.0}},
    {"type": "checkpoint", "params": {"name": "trial_a_coast_hold_160_begin"}},
    {"type": "hold", "params": {"duration_s": 4.0}},
    {"type": "checkpoint", "params": {"name": "trial_a_coast_drive_release_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.0, "duration_s": 1.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_throttle"}},
    {"type": "checkpoint", "params": {"name": "trial_a_coast_passive_decel_begin"}},
    {"type": "hold", "params": {"duration_s": 9.0}},
    {"type": "checkpoint", "params": {"name": "trial_a_coast_complete"}}
  ]
}
