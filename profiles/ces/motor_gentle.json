{
  "schema_version": 3,
  "name": "ces_motor_gentle_candidate",
  "description": "MEMORY-ONLY commissioning candidate: modeled 0.30 V coast, smooth 0.60 V drive plateau, return to modeled coast without a braking phase. Neither neutral nor the drive/current limits are physically commissioned.",
  "output": "vesc_throttle",
  "timeout_s": 30,
  "completion": {"mode": "return_neutral", "value": 0.3},
  "requires": {"motor_neutral": true, "motor_enable": "operator_verified"},
  "steps": [
    {"type": "assert_preconditions", "params": {"motor_neutral": true}},
    {"type": "set_aout", "params": {"channel": "vesc_throttle", "value": 0.3}},
    {"type": "checkpoint", "params": {"name": "candidate_gentle_acceleration_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.6, "duration_s": 3.0}},
    {"type": "checkpoint", "params": {"name": "candidate_gentle_drive_060_begin"}},
    {"type": "hold", "params": {"duration_s": 4.0}},
    {"type": "checkpoint", "params": {"name": "candidate_gentle_return_to_coast_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.3, "duration_s": 3.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_throttle"}},
    {"type": "checkpoint", "params": {"name": "candidate_gentle_complete"}}
  ]
}
