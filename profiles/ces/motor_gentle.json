{
  "schema_version": 3,
  "name": "ces_motor_gentle_candidate",
  "description": "MEMORY-ONLY current-control commissioning candidate: ramp from 0 V normal stop demand to 0.60 V positive current demand, hold demand briefly, and ramp to 0 V. Demand is not regulated speed. Normal stopping does not establish a safe fault response or prove regeneration.",
  "output": "vesc_throttle",
  "timeout_s": 30,
  "completion": {"mode": "return_neutral", "value": 0.0},
  "requires": {"motor_neutral": true, "motor_enable": "operator_verified"},
  "steps": [
    {"type": "assert_preconditions", "params": {"motor_neutral": true}},
    {"type": "set_aout", "params": {"channel": "vesc_throttle", "value": 0.0}},
    {"type": "checkpoint", "params": {"name": "candidate_gentle_acceleration_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.6, "duration_s": 3.0}},
    {"type": "checkpoint", "params": {"name": "candidate_gentle_current_060_hold_begin"}},
    {"type": "hold", "params": {"duration_s": 4.0}},
    {"type": "checkpoint", "params": {"name": "candidate_gentle_normal_stop_ramp_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.0, "duration_s": 3.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_throttle"}},
    {"type": "checkpoint", "params": {"name": "candidate_gentle_complete"}}
  ]
}
