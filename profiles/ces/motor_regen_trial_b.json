{
  "schema_version": 3,
  "name": "ces_motor_regen_trial_b",
  "description": "Run Regen Test Trial B (unmatched open-loop timing): ADC1 accel to 1.60 V, drive-to-zero+verify, then prompt ADC2 brake using assignment parameter brake_target_v, independent of the configured output ceiling. Does not claim matched RPM or recovered energy without measured feedback. Physical use requires explicit output authorization and brake-release confirmation.",
  "output": "vesc_throttle",
  "outputs": ["vesc_throttle", "vesc_brake"],
  "timeout_s": 40,
  "completion": {"mode": "return_neutral", "value": 0.0},
  "requires": {"motor_neutral": true, "motor_enable": "operator_verified", "brake_released": true},
  "steps": [
    {"type": "assert_preconditions", "params": {"motor_neutral": true, "brake_released": true}},
    {"type": "set_aout", "params": {"channel": "vesc_throttle", "value": 0.0}},
    {"type": "set_aout", "params": {"channel": "vesc_brake", "value": 0.0}},
    {"type": "checkpoint", "params": {"name": "trial_b_regen_accel_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 1.6, "duration_s": 3.0}},
    {"type": "checkpoint", "params": {"name": "trial_b_regen_hold_160_begin"}},
    {"type": "hold", "params": {"duration_s": 4.0}},
    {"type": "checkpoint", "params": {"name": "trial_b_regen_drive_release_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.0, "duration_s": 1.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_throttle"}},
    {"type": "checkpoint", "params": {"name": "trial_b_regen_brake_prompt_begin"}},
    {"type": "hold", "params": {"duration_s": 0.5}},
    {"type": "ramp_aout", "params": {"channel": "vesc_brake", "target": {"parameter": "brake_target_v"}, "duration_s": 1.0}},
    {"type": "checkpoint", "params": {"name": "trial_b_regen_brake_hold"}},
    {"type": "hold", "params": {"duration_s": 4.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_brake", "target": 0.0, "duration_s": 1.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_brake"}},
    {"type": "checkpoint", "params": {"name": "trial_b_regen_complete"}},
    {"type": "hold", "params": {"duration_s": 2.0}}
  ]
}
