{
  "schema_version": 3,
  "name": "ces_motor_four_level_candidate",
  "description": "MEMORY-ONLY commissioning candidate retaining the multi-level concept: four 0.40/0.60/0.80/1.00 V demand plateaus, 4 s each, return to modeled 0.30 V coast. Historical filename retained for assignment traceability. Stable operation and efficiency require OXYGEN measurements; neither is inferred from demand.",
  "output": "vesc_throttle",
  "timeout_s": 45,
  "completion": {"mode": "return_neutral", "value": 0.3},
  "requires": {"motor_neutral": true, "motor_enable": "operator_verified"},
  "steps": [
    {"type": "assert_preconditions", "params": {"motor_neutral": true}},
    {"type": "set_aout", "params": {"channel": "vesc_throttle", "value": 0.3}},
    {"type": "checkpoint", "params": {"name": "candidate_scan_ramp_040_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.4, "duration_s": 1.0}},
    {"type": "checkpoint", "params": {"name": "candidate_scan_hold_040_begin"}},
    {"type": "hold", "params": {"duration_s": 4.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.6, "duration_s": 1.0}},
    {"type": "checkpoint", "params": {"name": "candidate_scan_hold_060_begin"}},
    {"type": "hold", "params": {"duration_s": 4.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.8, "duration_s": 1.0}},
    {"type": "checkpoint", "params": {"name": "candidate_scan_hold_080_begin"}},
    {"type": "hold", "params": {"duration_s": 4.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 1.0, "duration_s": 1.0}},
    {"type": "checkpoint", "params": {"name": "candidate_scan_hold_100_begin"}},
    {"type": "hold", "params": {"duration_s": 4.0}},
    {"type": "checkpoint", "params": {"name": "candidate_scan_return_to_coast_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.3, "duration_s": 2.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_throttle"}},
    {"type": "checkpoint", "params": {"name": "candidate_scan_complete"}}
  ]
}
