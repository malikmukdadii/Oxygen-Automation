{
  "schema_version": 3,
  "name": "ces_motor_driving_cycle_candidate",
  "description": "CES Run Driving Cycle with ADC2 intervals: accel peaks 0.60 / 1.00 / 1.60 V, distinct coast and ADC2 brake windows tuned by assignment parameters brake_light_v and brake_heavy_v, brake released before every accel, drive zero+verify before every brake (~23 s). Unmatched open-loop timing; not regulated RPM.",
  "output": "vesc_throttle",
  "outputs": ["vesc_throttle", "vesc_brake"],
  "timeout_s": 45,
  "completion": {"mode": "return_neutral", "value": 0.0},
  "requires": {"motor_neutral": true, "motor_enable": "operator_verified", "brake_released": true},
  "steps": [
    {"type": "assert_preconditions", "params": {"motor_neutral": true, "brake_released": true}},
    {"type": "set_aout", "params": {"channel": "vesc_throttle", "value": 0.0}},
    {"type": "set_aout", "params": {"channel": "vesc_brake", "value": 0.0}},
    {"type": "checkpoint", "params": {"name": "cycle_burst_060_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.6, "duration_s": 2.0}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.0, "duration_s": 1.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_throttle"}},
    {"type": "checkpoint", "params": {"name": "cycle_coast_1"}},
    {"type": "hold", "params": {"duration_s": 1.0}},
    {"type": "checkpoint", "params": {"name": "cycle_brake_1"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_brake", "target": {"parameter": "brake_light_v"}, "duration_s": 0.5}},
    {"type": "hold", "params": {"duration_s": 1.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_brake", "target": 0.0, "duration_s": 0.5}},
    {"type": "return_neutral", "params": {"channel": "vesc_brake"}},
    {"type": "checkpoint", "params": {"name": "cycle_burst_100_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 1.0, "duration_s": 2.0}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.0, "duration_s": 1.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_throttle"}},
    {"type": "checkpoint", "params": {"name": "cycle_coast_2"}},
    {"type": "hold", "params": {"duration_s": 1.0}},
    {"type": "checkpoint", "params": {"name": "cycle_brake_2"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_brake", "target": {"parameter": "brake_heavy_v"}, "duration_s": 0.5}},
    {"type": "hold", "params": {"duration_s": 1.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_brake", "target": 0.0, "duration_s": 0.5}},
    {"type": "return_neutral", "params": {"channel": "vesc_brake"}},
    {"type": "checkpoint", "params": {"name": "cycle_burst_160_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 1.6, "duration_s": 2.0}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.0, "duration_s": 1.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_throttle"}},
    {"type": "checkpoint", "params": {"name": "cycle_final_coast"}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "checkpoint", "params": {"name": "cycle_complete"}}
  ]
}
