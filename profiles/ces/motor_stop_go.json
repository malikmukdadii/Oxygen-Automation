{
  "schema_version": 3,
  "name": "ces_motor_driving_cycle_candidate",
  "description": "MEMORY-ONLY current-control commissioning candidate: three increasing 0.40/0.60/1.00 V positive current-demand bursts from 0 V, separated by short zero-demand deceleration windows. These illustrate acceleration rates, not regulated RPM setpoints. Complete at 0 V normal stop demand; deceleration is not proof of regeneration or a safe fault response.",
  "output": "vesc_throttle",
  "timeout_s": 45,
  "completion": {"mode": "return_neutral", "value": 0.0},
  "requires": {"motor_neutral": true, "motor_enable": "operator_verified"},
  "steps": [
    {"type": "assert_preconditions", "params": {"motor_neutral": true}},
    {"type": "set_aout", "params": {"channel": "vesc_throttle", "value": 0.0}},
    {"type": "checkpoint", "params": {"name": "candidate_cycle_burst_040_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.4, "duration_s": 2.0}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "checkpoint", "params": {"name": "candidate_cycle_deceleration_1_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.0, "duration_s": 1.0}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "checkpoint", "params": {"name": "candidate_cycle_burst_060_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.6, "duration_s": 2.0}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "checkpoint", "params": {"name": "candidate_cycle_deceleration_2_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.0, "duration_s": 1.0}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "checkpoint", "params": {"name": "candidate_cycle_burst_100_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 1.0, "duration_s": 2.0}},
    {"type": "hold", "params": {"duration_s": 3.0}},
    {"type": "checkpoint", "params": {"name": "candidate_cycle_deceleration_3_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.0, "duration_s": 1.0}},
    {"type": "hold", "params": {"duration_s": 4.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_throttle"}},
    {"type": "checkpoint", "params": {"name": "candidate_cycle_complete"}}
  ]
}
