{
  "schema_version": 3,
  "name": "ces_motor_driving_cycle_candidate",
  "description": "MEMORY-ONLY commissioning candidate: three increasing 0.40/0.60/0.80 V drive bursts, modeled 0.30 V coast and explicit 0.15/0.10 V braking requests. No regulated speed or proven regenerative energy claim.",
  "output": "vesc_throttle",
  "timeout_s": 45,
  "completion": {"mode": "return_neutral", "value": 0.3},
  "requires": {"motor_neutral": true, "motor_enable": "operator_verified"},
  "steps": [
    {"type": "assert_preconditions", "params": {"motor_neutral": true}},
    {"type": "set_aout", "params": {"channel": "vesc_throttle", "value": 0.3}},
    {"type": "checkpoint", "params": {"name": "candidate_cycle_burst_040_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.4, "duration_s": 2.0}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.3, "duration_s": 1.0}},
    {"type": "checkpoint", "params": {"name": "candidate_cycle_coast_1_begin"}},
    {"type": "hold", "params": {"duration_s": 1.0}},
    {"type": "checkpoint", "params": {"name": "candidate_cycle_burst_060_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.6, "duration_s": 2.0}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "checkpoint", "params": {"name": "candidate_cycle_brake_015_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.15, "duration_s": 1.0}},
    {"type": "hold", "params": {"duration_s": 1.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.3, "duration_s": 1.0}},
    {"type": "checkpoint", "params": {"name": "candidate_cycle_coast_2_begin"}},
    {"type": "hold", "params": {"duration_s": 1.0}},
    {"type": "checkpoint", "params": {"name": "candidate_cycle_burst_080_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.8, "duration_s": 2.0}},
    {"type": "hold", "params": {"duration_s": 3.0}},
    {"type": "checkpoint", "params": {"name": "candidate_cycle_brake_010_begin"}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.1, "duration_s": 1.0}},
    {"type": "hold", "params": {"duration_s": 2.0}},
    {"type": "ramp_aout", "params": {"channel": "vesc_throttle", "target": 0.3, "duration_s": 1.0}},
    {"type": "hold", "params": {"duration_s": 1.0}},
    {"type": "return_neutral", "params": {"channel": "vesc_throttle"}},
    {"type": "checkpoint", "params": {"name": "candidate_cycle_complete"}}
  ]
}
