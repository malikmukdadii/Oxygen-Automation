{
  "schema_version": 2,
  "simulation_only": true,
  "live_control": {
    "enable_physical_aout": false,
    "enable_rzxa_output_toggle": false,
    "enable_real_rzxa_scpi": false,
    "require_explicit_hardware_authorization": true
  },
  "connection": {
    "host": "127.0.0.1",
    "port": 10001,
    "timeout_s": 0.5
  },
  "outputs": {
    "rzxa_voltage_demand": {
      "role": "supply_voltage_demand",
      "channel": null,
      "expected_id": null,
      "channel_discovery_required": true,
      "mode": "ConstOutput",
      "source": "CONST0",
      "const_property": "TRION/SourceChannel_A_CONST/Const0",
      "min_aout_v": 0.0,
      "max_aout_v": 0.5,
      "startup_aout_v": 0.0,
      "completion_policy": "hold_until_explicit_change",
      "mapping": {
        "type": "linear_provisional",
        "full_scale_aout_v": 10.0,
        "assumed_full_scale_bus_v": 800.0,
        "gain_bus_v_per_aout_v": 80.0,
        "verified": false
      },
      "output_enable": "NOT_CONTROLLED_BY_AOUT"
    },
    "vesc_throttle": {
      "role": "motor_throttle",
      "channel": null,
      "expected_id": null,
      "channel_discovery_required": true,
      "mode": "ConstOutput",
      "source": "CONST0",
      "const_property": "TRION/SourceChannel_A_CONST/Const0",
      "min_aout_v": 0.0,
      "max_aout_v": 0.4,
      "neutral_aout_v": 0.0,
      "neutral_verified": false,
      "completion_policy": "return_neutral"
    }
  },
  "timing": {
    "poll_ms": 50,
    "max_trigger_gap_ms": 250,
    "interval_ms": 100,
    "max_lateness_ms": 250
  },
  "telemetry": {
    "dc_bus_voltage_channel": null,
    "dc_bus_voltage_channel_verified": false,
    "max_feedback_age_s": 1.0,
    "require_measured_feedback_before_motor": true,
    "ramp_completion_vs_dc_bus": "separate"
  },
  "interlocks": {
    "motor_requires_measured_bus_in_range": true,
    "supply_down_requires_motor_neutral": true,
    "one_active_profile_global": true,
    "allow_unverified_simulated_interlock_values": true,
    "allow_unverified_live_interlock_values": false,
    "external_emergency_stop_required_for_live": true
  },
  "assignments": [
    {
      "name": "rzxa_to_40_hold",
      "enabled": true,
      "trigger": "DO 3/1 Sim",
      "output": "rzxa_voltage_demand",
      "profile": "profiles/rzxa_demand_ramp_40v_hold.json"
    },
    {
      "name": "rzxa_down",
      "enabled": true,
      "trigger": "DO 3/2 Sim",
      "output": "rzxa_voltage_demand",
      "profile": "profiles/rzxa_demand_ramp_down.json"
    },
    {
      "name": "rzxa_36_40_36",
      "enabled": true,
      "trigger": "DO 3/3 Sim",
      "output": "rzxa_voltage_demand",
      "profile": "profiles/rzxa_demand_36_40_36.json"
    },
    {
      "name": "motor_gentle",
      "enabled": true,
      "trigger": "DO 3/4 Sim",
      "output": "vesc_throttle",
      "profile": "profiles/motor_gentle_ramp.json"
    },
    {
      "name": "motor_stop_go",
      "enabled": true,
      "trigger": "DO 3/5 Sim",
      "output": "vesc_throttle",
      "profile": "profiles/motor_stop_go.json"
    },
    {
      "name": "motor_cruise",
      "enabled": true,
      "trigger": "DO 3/6 Sim",
      "output": "vesc_throttle",
      "profile": "profiles/motor_cruise_steps.json"
    }
  ],
  "dispatch": {
    "allow_multiple_bindings": true,
    "allow_simultaneous_execution": false,
    "polling_during_profile": "existing_blocking_behavior_for_now",
    "preserve_busy_press_ignore": true,
    "profile_schema": "v2_proposed_not_supported_by_current_code"
  }
}
